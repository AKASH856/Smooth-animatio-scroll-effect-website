{
  "name": "new-studio-nav",
  "version": "0.1.0",
  "description": "Scroll-driven floating pill navbar for React, smoothed by Lenis.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
